# ─────────────────────────────────────────────────────────────────────────────
# Environment template for Nahar Jewellers.
#
# Copy to `.env.local` for development, or set these in your host's environment
# for production. This file is the CANONICAL list of what the app reads — it is
# committed on purpose (it contains no real values); every actual `.env*` file
# is gitignored.
#
# THESE ARE THE ONLY VARIABLES THIS APP USES. The generic checklist names
# (DATABASE_URL, PAYMENT_SECRET_KEY, EMAIL_API_KEY, STORAGE_*, REDIS_URL,
# ENCRYPTION_KEY, NEXT_PUBLIC_SITE_URL) do NOT apply here — there is no payment
# gateway, no email service, no object storage, no Redis, no field encryption,
# and nothing is exposed to the browser. Do not add a NEXT_PUBLIC_ variable
# unless the value is genuinely safe to ship in the client bundle.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (discrete vars — NOT a single DATABASE_URL) ─────────────────────
# The defaults are XAMPP's; a production database must not use them.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=                 # PRODUCTION: set a real password. Empty is a dev-only default.
DB_NAME=lumina_jewelry
#
# Preview/staging and production MUST point at DIFFERENT databases (different
# DB_HOST or DB_NAME). A shared database means a preview deploy can mutate live
# orders and stock.

# ── Secrets (production refuses to boot without real values — see instrumentation.ts)
# AUTH_SECRET signs the customer session cookie: anyone who knows it can forge a
# login for any user. Generate with `openssl rand -hex 32`. Must be >= 32 chars.
AUTH_SECRET=

# ADMIN_PASSWORD is the single shared admin password. The dev default "lumina123"
# is printed in the source; production will not start with it.
ADMIN_PASSWORD=

# ── Optional ─────────────────────────────────────────────────────────────────
# CRON_SECRET protects /api/cron/expire-holds. If unset in production the
# endpoint returns 503 (fails closed), so set it if you schedule the sweep.
# Pass it as `Authorization: Bearer <value>` or `?key=<value>`.
CRON_SECRET=
