# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — every real one stays out of git; the template is committed so
# deployers have a canonical list of what to set.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude
AGENTS.md
CLAUDE.md

# Private document storage (Certificates of Authenticity, etc). These are served
# only through /api/documents against a signed URL — they are not public assets
# and they must never enter version control.
/private-uploads/

# test artifacts
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
